# Public backend configuration (safe for the browser)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Private server configuration — generate new values, never commit real ones
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD=CHOOSE_A_STRONG_ADMIN_PASSWORD

# Optional scheduled-task secrets
LOVABLE_CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
LOVABLE_CRON_SECRET_PREVIOUS=
